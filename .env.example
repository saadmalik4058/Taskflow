# ---------------------------------------------------------------------
# TEMPLATE FILE
#
# Copy this file to ".env" and fill in real values:
#
#     cp .env.example .env
#
# ".env" is listed in .gitignore, so your real values never reach the
# repository. This template is safe to commit because every value below
# is a placeholder.
# ---------------------------------------------------------------------

# The port the API listens on. Optional (defaults to 3000).
PORT=3000

# REQUIRED. MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# REQUIRED. Secret used to sign JSON Web Tokens. Anyone who knows this
# value can forge a valid login token, so it must be long and random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# One of: development | test | production
# Optional (defaults to development). "test" makes Jest skip the rate
# limiters and is set automatically by the test suite.
NODE_ENV=development

# Comma-separated list of browser origins allowed by CORS.
# Optional. When unset it falls back to the local development origins
# (localhost:3000, localhost:3001, localhost:5173, 127.0.0.1:5173).
# Use "*" to allow every origin - handy for quick testing, never in
# production.
CLIENT_URLS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (all optional) ------------------------------------
# How long a rate-limit window lasts, in milliseconds.
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests allowed per window across all routes.
RATE_LIMIT_MAX=500

# Maximum FAILED requests per window for /register and /login.
# Successful logins do not count toward this.
AUTH_RATE_LIMIT_MAX=20
